{
    "name": "iobroker.lightburn",
    "version": "0.0.1",
    "description": "ioBroker adapter for LightBurn UDP automation",
    "author": {
        "name": "Friebe"
    },
    "homepage": "https://github.com/friebe/ioBroker.lightburn",
    "license": "MIT",
    "keywords": [
        "iobroker",
        "lightburn",
        "laser",
        "udp",
        "automation"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/friebe/ioBroker.lightburn.git"
    },
    "engines": {
        "node": ">= 20"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.1"
    },
    "devDependencies": {
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.2.2",
        "@iobroker/types": "^7.2.2",
        "@types/node": "^20.19.24",
        "typescript": "~6.0.3"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "io-package.json",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint -c eslint.config.mjs",
        "prettier": "prettier --check .",
        "test:package": "mocha test/package --exit",
        "test": "npm run build && npm run lint && npm run prettier && npm run test:package"
    },
    "bugs": {
        "url": "https://github.com/friebe/ioBroker.lightburn/issues"
    },
    "readmeFilename": "README.md"
}
